# Operations Exception Agent Environment Configuration

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AI Operations Exception Agent"

# Database Configuration
# Local SQLite fallback: sqlite:///./data/ops_agent.db
# PostgreSQL / Cloud SQL: postgresql+psycopg2://ops_user:ops_password@localhost:5432/ops_agent
DATABASE_URL=sqlite:///./data/ops_agent.db

# Security & Secrets
# Leave blank in dev for multi-tier ephemeral fallback, or set strong 32+ character key
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Backend: 'local' or 'gcs'
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
GCS_BUCKET_NAME=ops-agent-source-documents

# Google Cloud & Vertex AI Gemini
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-pro
USE_MOCK_LLM_IN_DEV=true

# Frontend Rewrites
BACKEND_API_URL=http://127.0.0.1:8000
